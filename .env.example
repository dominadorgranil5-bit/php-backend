# Copy this file to .env and fill in real values. Never commit the real .env.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drewscafe
DB_USER=drewscafe_user
DB_PASS=change_me

# --- App ---
# Comma-separated list of origins allowed to call this API (your Expo web
# origin, e.g. http://localhost:8081). Use * only for local dev.
APP_CORS_ORIGINS=*
# Public base URL of THIS php backend (used to build the payment redirect URL)
APP_BASE_URL=https://your-domain.com/api
# Custom scheme from app.json "scheme" (used to hand off back to the mobile app)
APP_SCHEME=drewscafe
# Where uploaded menu photos are served from publicly
UPLOADS_BASE_URL=https://your-domain.com/uploads/menu-images

# --- PayMongo ---
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- PayMongo mode ---
# test = only sk_test_ keys are accepted (no real money). Change to live ONLY when going live with sk_live_.
PAYMONGO_MODE=test
# Optional destination for successful GCash receipts; defaults to MAIL_FROM, then SMTP_USER.
PAYMENT_NOTIFICATION_EMAIL=
# Where the browser returns after GCash on WEB (your Expo web address, no trailing slash), e.g.
# http://localhost:8081  or  http://192.168.1.123:8081
APP_WEB_URL=http://localhost:8081
